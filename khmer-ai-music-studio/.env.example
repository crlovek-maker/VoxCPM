# Copy to .env and edit. Real environment variables override this file.

# --- Where projects are stored (default: ./data) ---
# STUDIO_DATA_DIR=D:\KhmerStudioData

# --- Access token. REQUIRED in practice when you use --lan (phone/other computers). ---
# STUDIO_TOKEN=put-a-long-random-string-here

# --- Music model: ACE-Step 1.5 REST API (start it first: `uv run acestep-api` in the ACE-Step-1.5 folder) ---
ACESTEP_URL=http://127.0.0.1:8001
# ACESTEP_API_KEY=            # only if you started acestep-api with --api-key
# ACESTEP_MODEL=              # empty = server default (acestep-v15-turbo)
# ACESTEP_TIMEOUT_SECONDS=3600

# --- Which engine is pre-selected: acestep | heartmula | selftest ---
STUDIO_ENGINE=acestep

# --- Optional 2nd model (experimental): HeartMuLa (heartlib checkout + its own venv python) ---
# HEARTMULA_DIR=/home/you/heartlib
# HEARTMULA_PYTHON=/home/you/heartlib/.venv/bin/python
# HEARTMULA_CKPT=/home/you/heartlib/ckpt
# HEARTMULA_VERSION=3B
# HEARTMULA_LAZY_LOAD=true

# --- Optional local text model for lyric help (Ollama shown) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=

# --- Tools ---
# FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# STUDIO_ENABLE_SELFTEST=1     # 0 hides the "system test" (non-AI) engine

# ── សំនៀង AI Studio — environment ─────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real keys. All provider calls
# are made from the Next.js server; nothing here is exposed to the browser.

# Which provider to use. "elevenlabs" is the only real adapter shipped.
#  - unset / "auto": use ElevenLabs if ELEVENLABS_API_KEY is set, otherwise DEMO MODE
#  - "elevenlabs":   require credentials; generation fails with MISSING_CREDENTIALS if absent
#  - "demo":         always use demo mode (placeholder audio, no vocals), even if a key exists
MUSIC_PROVIDER=auto

# ElevenLabs Music API (https://elevenlabs.io/docs/api-reference/music)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=music_v1
# mp3_<sampleRate>_<kbps>; higher quality tiers may need a paid plan
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Override only for testing against a mock server
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Per-job upstream timeout in ms (music generation can take a minute or more)
ELEVENLABS_TIMEOUT_MS=300000

# Where job records and audio files are stored (relative to the project root)
DATA_DIR=.data
# Max simultaneous provider jobs (protects your credit balance)
MAX_CONCURRENT_JOBS=2
